  {"fieldname": "refund_invoice_no", "fieldtype": "Data", "label": "Credit Note FDN", "description": "URA-issued credit note Fiscal Document Number (T112 refundInvoiceNo). Sent as T114 invoiceNo.", "read_only": 1},
  {"fieldname": "task_id", "fieldtype": "Data", "label": "Approval Task ID", "description": "URA workflow task id (T112 taskId). Sent as T113 taskId.", "read_only": 1},
